# mybk-planner — configuration
#
# Copy this file to `.env` and fill in your own HCMUT myBK credentials.
# The .env file is git-ignored and never committed.
#
# Where does the tool read credentials from? (priority order)
#   1. CLI flags:            --username / --password / --mssv
#   2. Environment variables: MYBK_USERNAME / MYBK_PASSWORD / MYBK_MSSV
#   3. The .env file in the repo root (or passed via --env PATH)
# Legacy MYBK_TEST_* names still work as a fallback alias.

# HCMUT CAS login (BKNetId = the part of your @hcmut.edu.vn mail before the @)
# Quote the value if it contains '#' or spaces: PASSWORD="..."
MYBK_USERNAME=your.bknetid
MYBK_PASSWORD=your-password

# Student ID (MSSV). Optional: the tool auto-detects it from your profile;
# set this only to override the auto-detected value.
MYBK_MSSV=2212345
